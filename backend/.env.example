# ==============================================================================
# CampusQuery Backend Environment Configuration Template
# ==============================================================================

# ── Cloud LLM & Gateways ──
GROQ_API_KEY=gsk_your_groq_api_key
PORTKEY_API_KEY=your_portkey_api_key
PORTKEY_CONFIG_SLUG=your_portkey_config_slug
GROQ_MODEL=qwen3:32b-a3b

# ── Hugging Face Tokens (Granular per component with HF_TOKEN fallback) ──
# Main global fallback token:
HF_TOKEN=hf_your_main_huggingface_token

# Distinct Hugging Face keys for separate rate-limits / quotas:
HF_EMBEDDING_TOKEN=hf_embedding_token_here
HF_RERANKER_TOKEN=hf_reranker_token_here
HF_GUARDRAIL_TOKEN=hf_guardrail_token_here
HF_MEMORY_TOKEN=hf_memory_token_here
HF_QUERY_REWRITER_TOKEN=hf_query_rewriter_token_here

# ── Embedding & Reranking Models (100% Cloud Inference) ──
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_INFERENCE_PROVIDER=
CHUNK_SIZE=384
CHUNK_OVERLAP=48
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=true
RETRIEVAL_TOP_K=5
RERANK_TOP_N=20
RERANK_SCORE_THRESHOLD=-15.0

# ── PostgreSQL & pgvector Database ──
POSTGRES_URL=postgresql://username:password@hostname:5432/database_name
PGVECTOR_TABLE=campusquery_chunks
HNSW_M=16
HNSW_EF_CONSTRUCT=100
HNSW_EF_SEARCH=128

# ── Safety Guardrails & Query Rewriting ──
HF_GUARDRAIL_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_INFERENCE_PROVIDER=featherless-ai
GUARD_BLOCK_THRESHOLD=0.30
QUERY_REWRITER_MODEL=Qwen/Qwen3-0.6B
QUERY_REWRITER_PROVIDER=featherless-ai

# ── Memory & Conversation Summarizer ──
SUMMARIZER_PROVIDER=huggingface
SUMMARIZER_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
SUMMARIZER_INFERENCE_PROVIDER=nscale
SUMMARIZER_TEMPERATURE=0.0
SUMMARIZER_MAX_TOKENS=500
MEMORY_RECENT_MESSAGES=4
MEMORY_COMPACTION_THRESHOLD=10
MEMORY_SUMMARY_MAX_CHARS=6000

# ── Affinda Resume Parser ──
AFFINDA_API_KEY=your_affinda_api_key

# ── Authentication & Security ──
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://resumetool.onrender.com

# ── Observability & Monitoring (Pydantic Logfire) ──
LOGFIRE_TOKEN=your_pydantic_logfire_token
LOGFIRE_SERVICE_NAME=campusquery-backend
LOGFIRE_ENVIRONMENT=production
LOGFIRE_SCRUBBING=true

# ── Email Service (SMTP) ──
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
